{
  "name": "cast-adrift",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/buildSite.mts",
    "size:check": "tsx scripts/sizeCheck.mts",
    "i18n:translate": "tsx scripts/translate.mts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.mts",
    "sim:smoke": "tsx scripts/sim.mts --enemy raider --runs 100 --seed 7",
    "sim:chart": "tsx scripts/chartSim.mts",
    "lint:content": "tsx scripts/contentLint.mts",
    "test:rules": "tsx scripts/rulesTest.mts",
    "gensfx": "tsx scripts/genSfx.mts",
    "sim:sweep": "tsx scripts/sim.mts --mode sweep --runs 500 --seed 11",
    "sim:perks": "tsx scripts/sim.mts --mode perks --runs 200 --sector 2 --seed 5",
    "sim:economy": "tsx scripts/sim.mts --mode economy --runs 200 --seed 11",
    "lint:keys": "tsx scripts/missingKeys.mts"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@tma.js/sdk": "^3.2.3",
    "firebase": "^12.15.0",
    "firebase-admin": "^13.10.0",
    "howler": "^2.2.4",
    "i18next": "^26.3.4",
    "matter-js": "^0.20.0",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.0",
    "@types/howler": "^2.2.13",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vercel/node": "^5.8.22",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  }
}
