rules_version = '2';

// Cast Adrift — Firestore security rules.
// Phase 9: per-user documents stay locked to their owner; leaderboard entries are
// client-written but shape- and range-validated, one doc per uid, no deletes.
// Anti-cheat is deterrence, not prevention (docs/DESIGN.md §15): there is no
// server function in v1, so implausible entries are shadow-flagged and hidden by
// every reader instead of being rejected outright.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Single meta progress document: { v, updatedAt, data }
      match /meta/progress {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.v is int
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt <= request.time.toMillis()
          && request.resource.data.data is string
          && request.resource.data.data.size() < 200000;
      }

      // Single run snapshot document: { v, savedAt, payload }
      match /run/current {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 100000;
      }

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Boards are public to any signed-in client; a client may only ever write the
    // single document whose id equals its own uid.
    match /leaderboards/{board}/entries/{uid} {

      function shapeOk(d) {
        return d.score is int
          && d.score >= 0
          && d.score <= 500000
          && d.level is int
          && d.level >= 1
          && d.level <= 50
          && d.depth is int
          && d.depth >= 0
          && d.depth <= 5000
          && d.kills is int
          && d.kills >= 0
          && d.kills <= 20000
          && d.scrap is int
          && d.scrap >= 0
          && d.scrap <= 400000
          && d.name is string
          && d.name.size() > 0
          && d.name.size() <= 24
          && d.ship is string
          && d.ship.size() > 0
          && d.ship.size() <= 32
          && d.updatedAt is int
          // A ±5 min window around the server clock: the field stays an int so
          // the client can sort and tie-break on it, but it cannot be backdated.
          && d.updatedAt <= request.time.toMillis() + 60000
          && d.updatedAt >= request.time.toMillis() - 300000;
      }

      function optionalsOk(d) {
        return (!('hash' in d) || d.hash is int)
          && (!('flagged' in d) || d.flagged == true)
          && (!('state' in d) || d.state in ['started', 'done']);
      }

      allow read: if request.auth != null;
      allow create, update: if isOwner(uid)
        && shapeOk(request.resource.data)
        && optionalsOk(request.resource.data);
      allow delete: if false;
    }

    match /leaderboards/{board} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /dailies/{day} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Phase 12 crash reports. Append-only from the client, never readable by it:
    // a player must not be able to enumerate other players' stack traces, and a
    // crash loop must not be able to rewrite or delete what it already wrote.
    // The client-side limiter (5/session, 1/10 s, deduped) is the first line;
    // these bounds are the one the client cannot talk its way past.
    match /errors/{day}/items/{item} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
          ['at', 'message', 'stack', 'screen', 'version'])
        && request.resource.data.at is int
        && request.resource.data.at <= request.time.toMillis() + 60000
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 300
        && request.resource.data.stack is string
        && request.resource.data.stack.size() <= 1000
        && request.resource.data.screen is string
        && request.resource.data.screen.size() <= 32
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 32;
    }

    match /errors/{day} {
      allow read, write: if false;
    }
  }
}
