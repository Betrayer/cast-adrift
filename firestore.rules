rules_version = '2';

// Cast Adrift — Firestore security rules.
// Phase 7 DRAFT: locks per-user documents to their owner and validates the
// meta/progress doc shape. Full validation (range/monotonicity/anti-cheat,
// leaderboard plausibility) lands in Phase 9 per docs/DESIGN.md §15.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Single meta progress document: { v, updatedAt, data }
      match /meta/progress {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.v is int
          && request.resource.data.updatedAt is int
          && request.resource.data.updatedAt <= request.time.toMillis()
          && request.resource.data.data is string
          && request.resource.data.data.size() < 200000;
      }

      // Single run snapshot document: { v, savedAt, payload }
      match /run/current {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 100000;
      }

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Leaderboards / dailies: read-only to clients here; writes go through a
    // trusted server function in Phase 9. Deny direct client writes for now.
    match /leaderboards/{mode}/entries/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /dailies/{day} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
